# oonfeeWRT pre-deployment OpenWrt config
# Adjust PROFILE per target

CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_lldpd=m
CONFIG_PACKAGE_nlbwmon=m
CONFIG_PACKAGE_vnstat2=m

# Keep SSH enabled for lab
CONFIG_PACKAGE_dropbear=y

# Disable forced password change for lab convenience – DO NOT ship
CONFIG_PACKAGE_dropbear=y
